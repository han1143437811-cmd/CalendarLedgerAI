<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_day" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="1dp" android:paddingBottom="1dp">
    <LinearLayout android:id="@+id/widget_day_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/widget_day_background">
        <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_date" android:layout_width="20dp" android:layout_height="18dp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textSize="14dp" android:textColor="#37433F" android:singleLine="true" />
            <ImageView android:id="@+id/widget_weather" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="1dp" android:visibility="gone" android:scaleType="fitCenter" />
            <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:importantForAccessibility="no" />
            <TextView android:id="@+id/widget_event_more" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:textSize="7dp" android:visibility="gone" android:layout_marginStart="1dp" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/widget_holiday_badge" android:layout_width="6dp" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:textSize="6.5dp" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/widget_observance" android:layout_width="match_parent" android:layout_height="9dp" android:gravity="start|center_vertical" android:includeFontPadding="false" android:textSize="7dp" android:singleLine="true" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_event" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="1dp" android:paddingStart="2dp" android:paddingEnd="1dp" android:gravity="center_vertical|start" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textSize="8.5dp" android:maxLines="2" android:breakStrategy="simple" android:ellipsize="end" android:background="@drawable/widget_event_background" android:visibility="gone" />
            <TextView android:id="@+id/widget_event_second" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="1dp" android:paddingStart="2dp" android:paddingEnd="1dp" android:gravity="center_vertical|start" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textSize="8.5dp" android:maxLines="2" android:breakStrategy="simple" android:ellipsize="end" android:background="@drawable/widget_event_background" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/widget_expense" android:letterSpacing="0" android:layout_width="match_parent" android:layout_height="10dp" android:gravity="start|center_vertical" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textSize="8.5dp" android:singleLine="true" android:visibility="gone" />
        <TextView android:id="@+id/widget_income" android:letterSpacing="0" android:layout_width="match_parent" android:layout_height="10dp" android:gravity="start|center_vertical" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textSize="8.5dp" android:singleLine="true" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>